{
  "name": "link-shortener",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "npx dotenv-cli -e .env.test -- vitest run --config vitest.integration.config.mts",
    "test:e2e": "npx dotenv-cli -e .env.test -- playwright test",
    "start:test": "npx dotenv-cli -e .env.test -- npm run build && npx dotenv-cli -e .env.test -- next start -p 3100",
    "db:test:migrate": "npx dotenv-cli -e .env.test -- prisma migrate deploy",
    "db:prod:migrate": "npx dotenv-cli -e .env.prod-db -- prisma migrate deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.74.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
